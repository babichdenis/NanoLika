{
	# Let's Encrypt writes to this address when a certificate is about to expire
	# and could not be renewed. Empty is allowed; scripts/self-host.sh fills it in.
	email "{$ACME_EMAIL}"
}

{$CLOUD_DOMAIN} {
	# compressed, except the operator's samples export: it is sent whole with its length,
	# and a download that gets re-encoded on the way has none
	@compressible not path /v1/admin/samples/export
	encode @compressible zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# A chat request may carry a few screenshots and one frame of the hub a file, so
	# the body limit sits just above the relay's MAX_REQUEST_BYTES (16 MiB) and
	# HUB_FRAME_LIMIT; the relay answers 413 with its own message before Caddy would.
	request_body {
		max_size 20MB
	}

	# The sign-in shell is public; administrative JSON stays password-protected.
	@prices_alias path /app/prices /app/admin/prices /app/admin/prices/
	redir @prices_alias https://{host}/app/prices/ 308
	@operator_path path /app/prices/* /v1/admin/prices
	handle @operator_path {
		reverse_proxy relay:8787 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# The desktop's installers and update feeds: scripts/publish-updates.mjs writes
	# ./dl/win (latest.yml + the NSIS .exe electron-updater reads) and ./dl/mac
	# (latest.json + the dmg/zip update-lika.py reads). It is a plain file server.
	handle_path /dl/* {
		root * /srv/dl
		header {
			# an installer never changes under its name, and one is 100–400 MB
			Cache-Control "public, max-age=31536000, immutable"
			-Server
		}
		file_server
	}

	# The store: skills, code capsules and MCP descriptions the app fetches when a job needs
	# them instead of carrying them in the installer (docs/store.md). Its catalogue,
	# index.json, is short-lived: a package installed today should be visible in a minute.
	handle_path /store/* {
		root * /srv/store
		header {
			-Server
		}
		# handle_path strips /store, so this matcher sees the bare path
		@catalogue path /index.json
		header @catalogue Cache-Control "public, max-age=60"
		file_server
	}

	handle {
		reverse_proxy relay:8787 {
			# Chat streams (SSE) and the hub's WebSocket must not be buffered.
			flush_interval -1
			# the relay keys its per-address limits on this; the visitor's own header is replaced
			header_up X-Forwarded-For {remote_host}
			# 10 minutes idle: a hub socket pings every 25 s, a long chat answer streams
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}
}
