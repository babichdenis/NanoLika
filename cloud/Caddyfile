{
	# Let's Encrypt writes to this address when a certificate is about to expire
	# and could not be renewed. Empty is allowed; scripts/self-host.sh fills it in.
	email "{$ACME_EMAIL}"
}

{$CLOUD_DOMAIN} {
	# compressed, except the operator's samples export: it is sent whole with its length,
	# and a download that gets re-encoded on the way has none
	@compressible not path /v1/admin/samples/export
	encode @compressible zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# A chat request may carry a few screenshots and one frame of the hub a file, so
	# the body limit sits just above the relay's MAX_REQUEST_BYTES (16 MiB) and
	# HUB_FRAME_LIMIT; the relay answers 413 with its own message before Caddy would.
	request_body {
		max_size 20MB
	}

	# The operator's numbers are not on a named path: a neutral address, a password, and
	# this box serving the page itself. Nothing here depends on another server.
	@ops_page path /cfp64ns5jgh4er8uxhis3t5t /cfp64ns5jgh4er8uxhis3t5t/*
	handle_path /cfp64ns5jgh4er8uxhis3t5t/* {
		@need_auth not remote_ip 95.221.28.57
		basic_auth @need_auth {
			operator $2a$14$YcdIgoFyhahtDuB1bJ.GR.a6wjIozJMn8Nl8QxNrPqnDv5pBUwmvC
		}
		# the encyclopedia of models sits under the same address but is not the prices page:
		# its files are served from /app/models, everything else goes to /app/prices
		@models path /models/*
		rewrite @models /app{path}
		rewrite * /app/prices{uri}
		reverse_proxy relay:8787
	}
	handle /cfp64ns5jgh4er8uxhis3t5t {
		@need_auth not remote_ip 95.221.28.57
		basic_auth @need_auth {
			operator $2a$14$YcdIgoFyhahtDuB1bJ.GR.a6wjIozJMn8Nl8QxNrPqnDv5pBUwmvC
		}
		redir * /cfp64ns5jgh4er8uxhis3t5t/ 308
	}
	# База моделей: статические страницы проекта modelscope. Отдельный закрытый
	# адрес, чтобы не мешать странице цен и не зависеть от relay.
	@models_db path /phzhk6tnr6d0e2ac7j3ze8eose /phzhk6tnr6d0e2ac7j3ze8eose/*
	handle_path /phzhk6tnr6d0e2ac7j3ze8eose/* {
		@need_auth not remote_ip 95.221.28.57
		basic_auth @need_auth {
			operator $2a$14$LCuXh31MUu6YdbveyN0yn.SZecZ.dcCvuLyzwmoCerevR0NqnDDrG
		}
		root * /srv/models
		file_server
		header {
			X-Content-Type-Options nosniff
			Cache-Control "no-cache"
			-Server
		}
	}
	handle /phzhk6tnr6d0e2ac7j3ze8eose {
		@need_auth not remote_ip 95.221.28.57
		basic_auth @need_auth {
			operator $2a$14$LCuXh31MUu6YdbveyN0yn.SZecZ.dcCvuLyzwmoCerevR0NqnDDrG
		}
		redir * /phzhk6tnr6d0e2ac7j3ze8eose/ 308
	}
	@ops_numbers path /v1/admin/prices
	handle @ops_numbers {
		@need_auth not remote_ip 95.221.28.57
		basic_auth @need_auth {
			operator $2a$14$YcdIgoFyhahtDuB1bJ.GR.a6wjIozJMn8Nl8QxNrPqnDv5pBUwmvC
		}
		reverse_proxy relay:8787
	}

	# The old named pages answer "not found": nothing says where the numbers live now.
	@named_pages path /app/prices /app/prices/* /app/admin/prices /app/admin/prices/* /app/menu-admin /app/menu-admin/* /v1/admin/menu
	handle @named_pages {
		respond 404
	}

	# The desktop's installers and update feeds: scripts/publish-updates.mjs writes
	# ./dl/win (latest.yml + the NSIS .exe electron-updater reads) and ./dl/mac
	# (latest.json + the dmg/zip update-lika.py reads). It is a plain file server.
	handle_path /dl/* {
		root * /srv/dl
		header {
			# an installer never changes under its name, and one is 100–400 MB
			Cache-Control "public, max-age=31536000, immutable"
			-Server
		}
		file_server
	}

	# The store: skills, code capsules and MCP descriptions the app fetches when a job needs
	# them instead of carrying them in the installer (docs/store.md). Its catalogue,
	# index.json, is short-lived: a package installed today should be visible in a minute.
	handle_path /store/* {
		root * /srv/store
		header {
			-Server
		}
		# handle_path strips /store, so this matcher sees the bare path
		@catalogue path /index.json
		header @catalogue Cache-Control "public, max-age=60"
		file_server
	}

	handle {
		# CORS for WebApp (nanolika.ru)
		@options_webapp {
			method OPTIONS
			header Origin https://nanolika.ru
		}
		handle @options_webapp {
			header Access-Control-Allow-Origin "https://nanolika.ru"
			header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
			header Access-Control-Allow-Headers "Authorization, Content-Type, X-Bot-Token"
			header Access-Control-Allow-Credentials "true"
			header Access-Control-Max-Age "86400"
			respond "" 204
		}
		@cors_webapp header Origin https://nanolika.ru
		header @cors_webapp {
			Access-Control-Allow-Origin "https://nanolika.ru"
			Access-Control-Allow-Credentials "true"
		}
		reverse_proxy relay:8787 {
			# Chat streams (SSE) and the hub's WebSocket must not be buffered.
			flush_interval -1
			# the relay keys its per-address limits on this; the visitor's own header is replaced
			header_up X-Forwarded-For {remote_host}
			# 10 minutes idle: a hub socket pings every 25 s, a long chat answer streams
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}
}
