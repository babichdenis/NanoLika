  "vendored": [
    {
      "name": "pyobjc-framework-Vision",
      "version": "12.2.2"
    },
    {
      "name": "pyobjc-framework-Quartz",
      "version": "12.2.2"
    },
    {
      "name": "pyobjc-framework-CoreML",
      "version": "12.2.2"
    },
    {
      "name": "pyobjc-core",
      "version": "12.2.2"
    }
  ]
}
