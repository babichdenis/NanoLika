# local configuration & secrets
config/config.toml
config/*.local.toml
.env
.env.*
*.env
!.env.example
# the phones' build-time values, copied from the .example beside each (docs/ios.md, android/BUILDING.md)
android/src/ios/Configs/ProviderCustomization.xcconfig
android/src/android/app/provider-customization.properties

# runtime data
workspace/
*.db
*.enc
*.key
audit.jsonl
sessions/
logs/
# local backups made by hand before a deploy, and generated media that is not an asset
*.bak-*/
outputs/

# python
__pycache__/
*.py[cod]
*.egg-info/

# typescript incremental build state (web/, harness/)
*.tsbuildinfo
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# web app sources (the production build in nanomuse/server/static IS committed)
web/node_modules/
web/dist/
web/.vite/
npm-debug.log*

# website: generated from web/ and docs/ by `npm run site:mascot` (see site/README.md)
site/assets/
# the docs site, built by pages.yml from website/ into site/docs/
site/docs/

# nanoMuse on DeepSeek Harness (harness/README.md): built by `pnpm build`, not committed
harness/dsh-nanomuse/node_modules/
harness/dsh-nanomuse/lib/

# android app (the signing key lives outside the repo; see docs/android.md)
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
# the Kotlin daemon's session files, beside the Gradle project (android/src/android)
android/src/android/.kotlin/
android/native/build/
*.jks
*.keystore
*.apk
*.aab

# editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# uv lockfile: the project installs with `uv pip install -e .`, not `uv sync`
uv.lock

# nanoMuse Cloud relay runtime data
cloud/data/
cloud/nanomuse_cloud/console/providers/prices.json

# the store's capsules are built, not committed: vendored wheels (12 MB of .so) and their
# zips are made by cloud/scripts/store_build_capsule.py (docs/store.md)
cloud/store/capsules/*/*/*.zip
cloud/store/capsules/*/*/Vision/
cloud/store/capsules/*/*/Quartz/
cloud/store/capsules/*/*/CoreML/
cloud/store/capsules/*/*/objc/
cloud/store/capsules/*/*/Foundation/

# the model encyclopedia is built, not committed: 2 MB of market data rebuilt by
# cloud/scripts/model_catalog.py on a timer (docs/store.md)
cloud/nanomuse_cloud/console/prices/catalog.json
